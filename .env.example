# Copy to .env.local for development. In Vercel, set these per environment (Preview = staging,
# Production = production). NEVER commit real values. Only NEXT_PUBLIC_* reach the browser.

# Where things live. The renderer MUST be a different origin from the app (separate
# subdomain, or better a separate registrable domain) so customer pages share no cookies.
APP_ORIGIN=https://www.example.in
RENDERER_ORIGIN=https://wishes.example.in
DEPLOY_ENV=production            # local | staging | production (enables strict checks)

# Supabase (Project settings → API). The secret key bypasses RLS: server only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Razorpay (Dashboard → Settings → API keys / Webhooks).
# staging: rzp_test_ keys; production: rzp_live_ keys (enforced at startup).
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_API_BASE is only for local tests against tests/mocks/razorpay-mock.mjs; leave unset.

# Random 32+ byte secrets: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
APP_SECRET=                      # signs passcode-unlock cookies, keys IP hashes
CRON_SECRET=                     # Vercel Cron sends it as a Bearer token

# Optional: LOG_LEVEL=silent to mute info logs.

# Storage backups (GitHub Actions secrets, not Vercel):
# BACKUP_S3_ENDPOINT / BACKUP_S3_REGION / BACKUP_S3_BUCKET / BACKUP_S3_ACCESS_KEY_ID / BACKUP_S3_SECRET_ACCESS_KEY
